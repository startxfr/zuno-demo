# ADR-0604 WP-231: the runtime service (also what the mock tests need). Versions
# shared with other components come from platform/python/constraints.txt.
fastapi
uvicorn
# uvicorn serves the session WebSocket (/internal/worlds/{id}/stream) only with one of these installed: without it
# the upgrade is answered 404 and no world can stream (found on the first live session, 2026-11-08).
websockets
pydantic
httpx
numpy
pillow
# PyAV wheels bundle FFmpeg with libx264 (GPL, like this repository) and h264_nvenc.
av
prometheus-client
