# Build from the REPOSITORY ROOT (not this directory), same pattern as
# components/agent-runtime/Dockerfile - this image bakes in
# evaluations/<agent>/ (ADR-0302 point 5: the `evaluate` stage runs the
# target agent's own quality_gate.py/run_acceptance_gate.py rather than a
# parallel harness):
#
#   docker build -f components/mlops/Containerfile -t zuno/mlops:local .
#
# FROM image below defaults to the zuno-ai-build ImageStream mirror
# (ansible/roles/image_mirrors), not registry.access.redhat.com directly.
# .github/workflows/build-publish.yml (ADR-0115) overrides this ARG to the
# real registry.access.redhat.com image, since its GitHub-hosted runners
# can't reach the cluster-internal mirror at all.
ARG BASE_IMAGE=image-registry.openshift-image-registry.svc:5000/zuno-ai-build/ubi9-python-311:latest
# ADR-0580/WP-165: content of the admitted zuno-demo-agents release this
# image bakes is read from the release pinned in platform/okf/agents.lock,
# never from a copy in this repository. This stage installs cosign and oras
# (pinned, checksum-verified), then platform/okf/release_cache.py verifies
# the release offline against the committed Sigstore trust root - exactly
# what `make d3 admit agents` checks - and extracts it to /okf. A release
# that does not verify fails the build. Needs egress to github.com (the two
# binaries) and quay.io (the release), like the pip installs already do.
FROM ${BASE_IMAGE} AS okf-release
USER 0
WORKDIR /src
COPY platform/okf/install_release_tools.py platform/okf/release_cache.py platform/okf/agents.lock ./platform/okf/
COPY platform/okf/sigstore ./platform/okf/sigstore
COPY platform/supply-chain/admit_okf_bundle.py platform/supply-chain/okf_narrowing.py ./platform/supply-chain/
RUN python3 platform/okf/install_release_tools.py /src/bin \
    && python3 -m pip install --no-cache-dir pyyaml==6.0.2 \
    && PATH="/src/bin:${PATH}" python3 platform/okf/release_cache.py > /src/release-path \
    && cp -r "$(cat /src/release-path)" /okf \
    && chmod -R a+rX /okf

FROM ${BASE_IMAGE}

USER 0
COPY components/mlops/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

COPY components/mlops/src/mlops.py /opt/app-root/src/mlops.py
# ADR-0538/WP-116. Copied EXPLICITLY, not via `COPY src/`: mlops.py imports
# this as a flat sibling module (both land in /opt/app-root/src, which is
# also the entrypoint's working directory), so a missing COPY here is a
# runtime ModuleNotFoundError inside the pipeline pod that no local test
# would catch.
COPY components/mlops/src/mlflow_tracking.py /opt/app-root/src/mlflow_tracking.py
# ADR-0539/WP-119, same reason as the line above and the same trap: the
# COPYs here are per-file, not `COPY src/`, so a new module that is not
# named here simply does not exist in the image. mlops.py's train-lora
# dispatcher imports this one, so a missing COPY would fail at runtime in
# the pipeline pod while every local test passed.
COPY components/mlops/src/trainjob.py /opt/app-root/src/trainjob.py
# WP-133: standalone (no mlops.py import - see its own docstring for why),
# run as gitops/charts/models' init-container command override, not via
# the mlops-run ENTRYPOINT below - same per-file-COPY trap as the two
# lines above, a missing one here is a ModuleNotFoundError only a live
# serving pod would ever hit.
COPY components/mlops/src/download_adapter.py /opt/app-root/src/download_adapter.py
COPY components/mlops/mlops-run /opt/app-root/src/mlops-run
RUN chmod 0755 /opt/app-root/src/mlops-run
COPY evaluations /opt/app-root/src/evaluations
# WP-087: evaluations/ alone is NOT enough, and the gap is invisible until
# a run actually happens. evaluations/<agent>/gate_checks.py and
# security_checks.py both resolve their repo root as
# pathlib.Path(__file__).resolve().parents[2] - which inside this image is
# /opt/app-root/src - and then read policies/... and
# platform/ai-gateway/provider-routing.yaml from there. Both check layers
# are mandatory (a failure is not skippable), so without these two COPYs
# the `evaluate` stage fails 100% of the time, on every agent, for a
# reason that looks nothing like a missing file.
#
# ADR-0580/WP-165: the corp policies these checks read (tools,
# model-routing, ...) come from the verified agents release (okf-release
# stage above); the platform's own policies (data-classification,
# optimization, database) from this repository. Both land under the same
# policies/ root the scripts resolve.
COPY policies /opt/app-root/src/policies
COPY --from=okf-release /okf/policies /opt/app-root/src/policies
COPY platform/ai-gateway /opt/app-root/src/platform/ai-gateway
# Third directory of the same gap, found only by running the gate: two
# gate_checks read agents/<name>/agent.okf.md off that same repo root
# (tekos_declares_no_dat_or_image_generation_capability and
# arkos_declares_no_photorealistic_image_generation_capability, both
# mandatory), so without this every run failed them with a bare ENOENT.
# The checks are cross-agent by design - a comage run still reads tekos's
# and arkos's bundles - so this cannot be narrowed to the target agent.
# mlops.py also reads each task's prompt from here (MLOPS_AGENTS_DIR).
# ADR-0580/WP-165: from the verified agents release, read at build time:
# this image has no Deployment to carry an okf-fetch init container (KFP
# pipeline components and a TrainingRuntime run it) and is rebuilt per
# training run, so the build is where the locked release is read.
COPY --from=okf-release /okf/agents /opt/app-root/src/agents

USER 1001
WORKDIR /opt/app-root/src
ENTRYPOINT ["/opt/app-root/src/mlops-run"]
