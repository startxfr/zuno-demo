# kubebuilder's default "exclude ** then re-include !**/*.go" pattern is
# not honored by OpenShift's buildah-based Docker builds - COPY . . copies
# an empty tree and the build fails with "package cmd/main.go is not in
# std". Plain exclude list instead; including test sources in the context
# is harmless (go build compiles only cmd/main.go's dependency graph).
bin/
test/
config/
hack/
Dockerfile
.dockerignore
*.md
