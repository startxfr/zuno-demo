{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["platform", "externalSecrets", "redhat", "s3", "postgres", "embedding", "images"],
  "properties": {
    "platform": {
      "type": "object",
      "required": ["namespace"],
      "properties": {"namespace": {"type": "string", "minLength": 1}}
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "storeRef": {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": {"enum": ["SecretStore", "ClusterSecretStore"]},
            "name": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "redhat": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["product", "productSlug", "version", "documentationUrl"],
        "properties": {
          "enabled": {"type": "boolean"},
          "product": {"type": "string", "minLength": 1},
          "productSlug": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "documentationUrl": {"type": "string", "minLength": 1}
        }
      }
    },
    "confluence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "baseUrl"],
        "properties": {
          "enabled": {"type": "boolean"},
          "name": {"type": "string"},
          "type": {"enum": ["cloud", "datacenter"]},
          "baseUrl": {"type": "string", "minLength": 1},
          "spaces": {
            "type": "array",
            "items": {"type": "string"},
            "description": "operator-supplied: replace demo placeholders with real Confluence Cloud space keys for this environment."
          },
          "directories": {
            "type": "array",
            "items": {"type": "string"},
            "description": "operator-supplied: replace demo placeholders with real page-tree paths for this environment."
          },
          "requiredGroups": {"type": "array", "items": {"type": "string"}},
          "technology": {
            "type": "string",
            "description": "ADR-0202 canonical cross-source technology value (knowledge/tech/domain.yaml technology_vocabulary) - explicit per source, never derived from the name."
          }
        }
      }
    },
    "domains": {
      "type": "object",
      "description": "ADR-0204 part 2 (WP-22): additional knowledge domains - the top-level redhat/confluence/postgres/schedule blocks are knowledge.tech's.",
      "additionalProperties": {
        "type": "object",
        "required": ["enabled", "fetchStages", "postgres", "schedule"],
        "properties": {
          "enabled": {"type": "boolean"},
          "fetchStages": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["fetch-redhat", "fetch-confluence", "fetch-salesforce", "fetch-aramis", "load-sxa-dump", "fetch-sxa"]}
          },
          "postgres": {
            "type": "object",
            "required": ["database", "schema", "secretName"],
            "properties": {
              "database": {"type": "string", "minLength": 1},
              "schema": {"type": "string", "minLength": 1},
              "secretName": {"type": "string", "minLength": 1}
            }
          },
          "schedule": {
            "type": "object",
            "required": ["enabled"],
            "properties": {
              "enabled": {"type": "boolean"},
              "cron": {"type": "string"},
              "timezone": {"type": "string"}
            }
          },
          "staleAfter": {
            "type": "string",
            "pattern": "^(\\d+[dhm]|none)$",
            "description": "WP-24/ADR-0109: mirrors this domain's knowledge/<domain>/domain.yaml freshness.operation_classes.semantic-read.max_staleness."
          }
        }
      }
    },
    "s3": {
      "type": "object",
      "required": ["type", "bucket", "region"],
      "properties": {
        "type": {"enum": ["aws", "odf", "minio", "ceph-rgw", "other"]},
        "bucket": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1}
      }
    },
    "postgres": {
      "type": "object",
      "required": ["host", "port", "database", "schema"],
      "properties": {
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "database": {"type": "string"},
        "schema": {"type": "string"}
      }
    },
    "embedding": {
      "type": "object",
      "required": ["endpoint", "model", "dimensions"],
      "properties": {
        "dimensions": {"type": "integer", "minimum": 1}
      }
    },
    "images": {
      "type": "object",
      "required": ["ingestion"],
      "properties": {
        "ingestion": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
