    },
    {
      "name": "board",
      "path": "/board",
      "attributes": {
        "description": [
          "Board / architects business role \u2014 grants Confluence/Drive/Gmail/sales-db/web-search/SMTP tool rights inside authorized agents (ADR-0040); does not by itself grant any frontend access"
        ]
      }
    }
