    {
      "name": "sales",
      "path": "/sales",
      "attributes": {
        "description": [
          "Sales business role \u2014 grants sales-db and web-search tool rights inside authorized agents (ADR-0040); does not by itself grant any frontend access"
        ]
      },
      "subGroups": [
        {
          "name": "sales_admin",
          "path": "/sales/sales_admin",
          "attributes": {
            "description": [
              "Privileged sales business role \u2014 may see all permitted sales records rather than only the authenticated sales owner's own deals (MEMORY.md section on Comage). Reserved: Comage has no runtime yet in v0, so this group is defined but not yet consumed by any policy."
            ]
          }
        }
      ]
    },
    {
      "name": "consultant",
      "path": "/consultant",
      "attributes": {
        "description": [
          "Technical consultant business role \u2014 grants Confluence/Drive/Gmail/web-search tool rights inside authorized agents (ADR-0040); does not by itself grant any frontend access"
        ]
      }
    },
    {
      "name": "adv",
      "path": "/adv",
      "attributes": {
        "description": [
          "Sales administration (ADV) business role \u2014 grants sales-db and web-search tool rights inside authorized agents (ADR-0040); does not by itself grant any frontend access"
        ]
      }
    },
    {
      "name": "finance",
      "path": "/finance",
      "attributes": {
        "description": [
          "Finance business role \u2014 grants web-search tool rights inside authorized agents (ADR-0040); does not by itself grant any frontend access"
        ]
