{
    "realm": "zuno",
    "enabled": true,
    "displayName": "Zuno Demo",
    "sslRequired": "external",
    "registrationAllowed": false,
    "resetPasswordAllowed": true,
    "editUsernameAllowed": false,
    "loginWithEmailAllowed": true,
    "duplicateEmailsAllowed": false,
    "accessTokenLifespan": 900,
    "ssoSessionIdleTimeout": 28800,
    "ssoSessionMaxLifespan": 36000,
    "roles": {
        "client": {
            "comage-frontend": [{
                "name": "access",
                "description": "Grants sign-in access to the Comage (sales) agent frontend"
            }],
            "tekos-frontend": [{
                "name": "access",
                "description": "Grants sign-in access to the Tekos (technical consultant) agent frontend"
            }],
            "advantage-frontend": [{
                "name": "access",
                "description": "Grants sign-in access to the Advantage (sales admin) agent frontend"
            }],
            "finage-frontend": [{
                "name": "access",
                "description": "Grants sign-in access to the Finage (finance) agent frontend"
            }],
            "arkos-frontend": [{
                "name": "access",
                "description": "Grants sign-in access to the Arkos (architects) agent frontend"
            }]
        }
    },
    "groups": [{
            "name": "agent_comage",
            "path": "/agent_comage",
            "attributes": {
                "description": [
                    "ADR-0040 agent entitlement group \u2014 grants sign-in access to the Comage frontend, independent of business role"
                ]
            },
            "clientRoles": {
                "comage-frontend": [
                    "access"
                ]
            }
        },
        {
            "name": "agent_tekos",
            "path": "/agent_tekos",
            "attributes": {
                "description": [
                    "ADR-0040 agent entitlement group \u2014 grants sign-in access to the Tekos frontend, independent of business role"
                ]
            },
            "clientRoles": {
                "tekos-frontend": [
                    "access"
                ]
            }
        },
        {
            "name": "agent_advantage",
            "path": "/agent_advantage",
            "attributes": {
                "description": [
                    "ADR-0040 agent entitlement group \u2014 grants sign-in access to the Advantage frontend, independent of business role"
                ]
            },
            "clientRoles": {
                "advantage-frontend": [
                    "access"
                ]
            }
        },
        {
            "name": "agent_finage",
            "path": "/agent_finage",
            "attributes": {
                "description": [
                    "ADR-0040 agent entitlement group \u2014 grants sign-in access to the Finage frontend, independent of business role"
                ]
            },
            "clientRoles": {
                "finage-frontend": [
                    "access"
                ]
            }
        },
        {
            "name": "agent_arkos",
            "path": "/agent_arkos",
            "attributes": {
                "description": [
                    "ADR-0040 agent entitlement group \u2014 grants sign-in access to the Arkos frontend, independent of business role"
                ]
            },
            "clientRoles": {
                "arkos-frontend": [
                    "access"
                ]
            }
        },
        {
            "name": "sales",
            "path": "/sales",
            "attributes": {
                "description": [
                    "Sales business role \u2014 grants sales-db and web-search tool rights inside authorized agents (ADR-0040); does not by itself grant any frontend access"
                ]
            },
            "subGroups": [{
                "name": "sales_admin",
                "path": "/sales/sales_admin",
                "attributes": {
                    "description": [
                        "Privileged sales business role \u2014 may see all permitted sales records, not only the authenticated sales owner's own deals. Reserved: Comage has no runtime yet in v0, so this group is defined but not yet consumed by any policy."
                    ]
                }
            }]
        },
        {
            "name": "consultant",
            "path": "/consultant",
            "attributes": {
                "description": [
                    "Technical consultant business role \u2014 grants Confluence/Drive/Gmail/web-search tool rights inside authorized agents (ADR-0040); does not by itself grant any frontend access"
                ]
            },
            "subGroups": [{
                    "name": "confluence-build-satellite",
                    "path": "/consultant/confluence-build-satellite",
                    "attributes": {
                        "description": [
                            "rag-ingestion ACL group \u2014 grants build-consultant-tier access to Red Hat Satellite Confluence content (acl_groups metadata, ADR-0046)"
                        ]
                    }
                },
                {
                    "name": "confluence-build-openshift",
                    "path": "/consultant/confluence-build-openshift",
                    "attributes": {
                        "description": [
                            "rag-ingestion ACL group \u2014 grants build-consultant-tier access to OpenShift Confluence content (acl_groups metadata, ADR-0046)"
                        ]
                    }
                },
                {
                    "name": "confluence-build-openshift-ai",
                    "path": "/consultant/confluence-build-openshift-ai",
                    "attributes": {
                        "description": [
                            "rag-ingestion ACL group \u2014 grants build-consultant-tier access to OpenShift AI Confluence content (acl_groups metadata, ADR-0046)"
                        ]
                    }
                },
                {
                    "name": "confluence-build-keycloak",
                    "path": "/consultant/confluence-build-keycloak",
                    "attributes": {
                        "description": [
                            "rag-ingestion ACL group \u2014 grants build-consultant-tier access to Keycloak Confluence content (acl_groups metadata, ADR-0046)"
                        ]
                    }
                },
                {
                    "name": "confluence-run-satellite",
                    "path": "/consultant/confluence-run-satellite",
                    "attributes": {
                        "description": [
                            "rag-ingestion ACL group \u2014 grants run-consultant-tier access to Red Hat Satellite Confluence content (acl_groups metadata, ADR-0046)"
                        ]
                    }
                },
                {
                    "name": "confluence-run-openshift",
                    "path": "/consultant/confluence-run-openshift",
                    "attributes": {
                        "description": [
                            "rag-ingestion ACL group \u2014 grants run-consultant-tier access to OpenShift Confluence content (acl_groups metadata, ADR-0046)"
                        ]
                    }
                },
                {
                    "name": "confluence-run-openshift-ai",
                    "path": "/consultant/confluence-run-openshift-ai",
                    "attributes": {
                        "description": [
                            "rag-ingestion ACL group \u2014 grants run-consultant-tier access to OpenShift AI Confluence content (acl_groups metadata, ADR-0046)"
                        ]
                    }
                },
                {
                    "name": "confluence-run-keycloak",
                    "path": "/consultant/confluence-run-keycloak",
                    "attributes": {
                        "description": [
                            "rag-ingestion ACL group \u2014 grants run-consultant-tier access to Keycloak Confluence content (acl_groups metadata, ADR-0046)"
                        ]
                    }
                },
                {
                    "name": "confluence-archi-satellite",
                    "path": "/consultant/confluence-archi-satellite",
                    "attributes": {
                        "description": [
                            "ADR-0340/WP-32: relocated from /board (ADR-0330's transitional architect container) - rag-ingestion ACL group, grants architect-tier access to Red Hat Satellite Confluence content (acl_groups metadata, ADR-0046)"
                        ]
                    }
                },
                {
                    "name": "confluence-archi-openshift",
                    "path": "/consultant/confluence-archi-openshift",
                    "attributes": {
                        "description": [
                            "ADR-0340/WP-32: relocated from /board (ADR-0330's transitional architect container) - rag-ingestion ACL group, grants architect-tier access to OpenShift Confluence content (acl_groups metadata, ADR-0046)"
                        ]
                    }
                },
                {
                    "name": "confluence-archi-openshift-ai",
                    "path": "/consultant/confluence-archi-openshift-ai",
                    "attributes": {
                        "description": [
                            "ADR-0340/WP-32: relocated from /board (ADR-0330's transitional architect container) - rag-ingestion ACL group, grants architect-tier access to OpenShift AI Confluence content (acl_groups metadata, ADR-0046)"
                        ]
                    }
                },
                {
                    "name": "confluence-archi-keycloak",
                    "path": "/consultant/confluence-archi-keycloak",
                    "attributes": {
                        "description": [
                            "ADR-0340/WP-32: relocated from /board (ADR-0330's transitional architect container) - rag-ingestion ACL group, grants architect-tier access to Keycloak Confluence content (acl_groups metadata, ADR-0046)"
                        ]
                    }
                }
            ]
        },
        {
            "name": "adv",
            "path": "/adv",
            "attributes": {
                "description": [
                    "Sales administration (ADV) business role \u2014 grants sales-db and web-search tool rights inside authorized agents (ADR-0040); does not by itself grant any frontend access"
                ]
            }
        },
        {
            "name": "finance",
            "path": "/finance",
            "attributes": {
                "description": [
                    "Finance business role \u2014 grants web-search tool rights inside authorized agents (ADR-0040); does not by itself grant any frontend access"
                ]
            }
        },
        {
            "name": "board",
            "path": "/board",
            "attributes": {
                "description": [
                    "Board / Direction business role \u2014 grants Confluence/Drive/Gmail/sales-db/web-search/SMTP tool rights inside authorized agents (ADR-0040); does not by itself grant any frontend access. ADR-0340/WP-32: the ADR-0330 confluence-archi-* architect-tier subgroups relocated to /consultant so `board` consistently means Direction, never a technical-skill container."
                ]
            }
        },
        {
            "name": "cdp",
            "path": "/cdp",
            "attributes": {
                "description": [
                    "ADR-0340/WP-32: project-manager business role \u2014 read-scoped Workday access (self.read + any.read, never any.update) plus the same Confluence/Drive/Gmail/Calendar/Meet rights as consultant inside authorized agents (see the ADR's access-intent table); does not by itself grant any frontend access."
                ]
            }
        },
        {
            "name": "admin",
            "path": "/admin",
            "attributes": {
                "description": [
                    "ADR-0320 platform-administrator profile \u2014 bound to cluster-admin via gitops/charts/openshift-rbac-groups; orthogonal to the agent_<name>/business-role dimensions above, gates cluster/Console access, not agent-app access"
                ]
            }
        },
        {
            "name": "zuno-admin",
            "path": "/zuno-admin",
            "attributes": {
                "description": [
                    "ADR-0320 Zuno-administrator profile \u2014 bound to the admin ClusterRole in every namespace labeled zuno.io/managed=true"
                ]
            }
        },
        {
            "name": "aidev",
            "path": "/aidev",
            "attributes": {
                "description": [
                    "ADR-0320 AI-developer profile \u2014 bound to edit in zuno-ai-build"
                ]
            }
        },
        {
            "name": "aiops",
            "path": "/aiops",
            "attributes": {
                "description": [
                    "ADR-0320 AI-Ops profile \u2014 bound to edit in zuno-ai-build and zuno-ai-run"
                ]
            }
        }
    ],
