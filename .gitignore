# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.kubeconfig
kubeconfig
vault-password*
ansible/confidential.yml

# Real / unapproved business data
*.dump
*.sql.gz

# Python / Ansible
__pycache__/
*.pyc
.venv/
.ansible/
*.retry

# Go / Node
bin/
node_modules/
dist/
coverage/

# Helm dependency downloads (ArgoCD/`helm dependency build` fetch these
# from Chart.yaml's dependencies at render time - see gitops/charts/vault,
# the one local chart wrapping an upstream chart as a dependency).
# Chart.lock IS committed, to pin the dependency version.
gitops/charts/*/charts/

# ADR-0305 (WP-40): generated benchmark artifacts - real content is
# produced by evaluations/benchmark.py against a live candidate, never
# hand-authored/committed. See evaluations/benchmarks/README.md.
evaluations/benchmarks/*.json

# Editors / OS
.DS_Store
.idea/
.vscode/
